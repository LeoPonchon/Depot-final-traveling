    <!-- Guide -->
    <string name="guide_title">Guide d’utilisation</string>
    <string name="guide_subtitle">Les bases pour utiliser TravelShare et TravelPath.</string>
    <string name="guide_open_share">Ouvrir TravelShare</string>
    <string name="guide_open_path">Ouvrir TravelPath</string>

    <string name="guide_section_objective_title">Objectif de l’app</string>
    <string name="guide_section_objective_body">ShimTraveling = découvrir des lieux + générer un parcours.\n\n• TravelShare : explorer / publier.\n• TravelPath : générer un itinéraire.\n• Profil : compte, favoris, groupes, ajouter un lieu.</string>

    <string name="guide_section_travelshare_title">TravelShare (découvrir &amp; publier)</string>
    <string name="guide_section_travelshare_body">• Recherchez et filtrez les photos/lieux.\n• Publiez une photo : lieu + description + tags (prix et moment si possible).\n• Depuis une recherche, lancez TravelPath pour générer un parcours.</string>

    <string name="guide_section_travelpath_title">TravelPath (générer un parcours)</string>
    <string name="guide_section_travelpath_body">• Choisissez une ville, des étapes et une durée.\n• Optionnel : tags et lieux obligatoires.\n• Générer → ouvrir un parcours → carte / navigation / PDF.</string>

    <string name="guide_section_add_place_title">Ajouter un lieu</string>
    <string name="guide_section_add_place_body">Profil → Ajouter un lieu.\nAjoutez : nom, type, ville, position, tags.\nPubliez ensuite une photo pour le rendre plus visible.</string>

    <string name="guide_section_pricing_title">Calcul du prix d’un parcours</string>
    <string name="guide_section_pricing_body">Le coût est estimé à partir des prix renseignés sur les photos (matin/après-midi/soir).\nS’il n’y a pas assez de prix, le coût peut être indisponible.</string>

